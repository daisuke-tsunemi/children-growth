# https://xxxxx.microcms.io の xxxxx
MICROCMS_SERVICE_DOMAIN=

# microCMSの設定 → APIキー から取得する読み取り専用キー(本アプリは表示専用のため書き込み権限は不要)
MICROCMS_API_KEY=

# ローカル開発時は http://localhost:3000 のままで可
BASE_URL=http://localhost:3000

# 画面全体をBasic認証で保護する。子どもの写真・健康情報を扱うため、デプロイして利用する場合は必ず設定する
# (ローカル開発では未設定でも可。未設定の場合は保護なしで起動し、起動時に警告を出す)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# 任意。スマホ等から開発サーバー(npm run dev)にPCのIPアドレスでアクセスする場合に、そのIPアドレスを設定する(カンマ区切りで複数可)。
# 未設定だとNext.jsが開発用リソースへの接続を遮断し、チャートやボタンが動かなくなる。本番環境では不要
ALLOWED_DEV_ORIGINS=
