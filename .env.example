# https://xxxxx.microcms.io の xxxxx
MICROCMS_SERVICE_DOMAIN=

# microCMSの設定 → APIキー から取得する読み取り専用キー(本アプリは表示専用のため書き込み権限は不要)
MICROCMS_API_KEY=

# ローカル開発時は http://localhost:3000 のままで可
BASE_URL=http://localhost:3000

# 任意。画面全体をBasic認証で保護する場合に設定する(子どもの写真・健康情報を扱うため、
# インターネットに公開する場合は設定を強く推奨。未設定の場合は保護なしで起動し、起動時に警告を出す)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
